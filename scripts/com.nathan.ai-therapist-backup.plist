<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.nathan.ai-therapist-backup</string>
  <key>ProgramArguments</key><array>
    <string>/Users/nathanblatter/docker-services/backup-ai-therapist.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>10</integer></dict>
  <!-- 04:10: after the 03:00 content wipe, 03:30 retention run, and the
       03:46 flightdeck dump, so the backup captures post-retention state. -->
  <key>StandardErrorPath</key>
  <string>/Users/nathanblatter/docker-services/ai-therapist-backups.log</string>
</dict></plist>
