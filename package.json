{
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts --dev",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:client && npm run build:admin-client && npm run build:redact-client && npm run build:server && npm run build:admin-server && npm run build:redact-server",
    "build:client": "APP=main vite build --outDir ../../../dist/client --ssrManifest",
    "build:admin-client": "APP=admin vite build --outDir ../../../dist/admin-client --ssrManifest",
    "build:redact-client": "APP=redact vite build --outDir ../../../dist/redact-client --ssrManifest",
    "build:server": "APP=main vite build --ssr entry-server.tsx --outDir ../../../dist/server --emptyOutDir",
    "build:admin-server": "APP=admin vite build --ssr admin-entry-server.tsx --outDir ../../../dist/admin-server --emptyOutDir",
    "build:redact-server": "APP=redact vite build --ssr redact-entry-server.tsx --outDir ../../../dist/redact-server --emptyOutDir",
    "devinstall": "zx ../../devinstall.mjs -- tsx src/server/index.ts --dev",
    "export:dataset": "tsx src/database/scripts/exportDataset.ts",
    "retention:run": "tsx src/database/scripts/runRetention.ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint -c .eslintrc.json . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint -c .eslintrc.json . --ext .js,.jsx,.ts,.tsx --fix",
    "redteam": "tsx src/redteam/cli.ts",
    "redteam:smoke": "tsx src/redteam/cli.ts --suite smoke",
    "redteam:full": "tsx src/redteam/cli.ts --suite full"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@socket.io/postgres-adapter": "^0.5.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "busboy": "^1.6.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.2",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.2.0",
    "history": "^5.3.0",
    "minipass": "^7.0.4",
    "openai": "^5.17.0",
    "openai-realtime-api": "^1.0.8",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-feather": "^2.0.10",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "speakeasy": "^2.0.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/bcrypt": "^5.0.2",
    "@types/busboy": "^1.5.4",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.6",
    "postcss-nesting": "^12.0.2",
    "postcss-preset-env": "^7.7.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.2.0",
    "vitest": "^2.1.9"
  }
}
