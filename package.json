{
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts --dev",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:client && npm run build:admin-client && npm run build:server",
    "build:client": "APP=main vite build --outDir ../../../dist/client --ssrManifest",
    "build:admin-client": "APP=admin vite build --outDir ../../../dist/admin-client",
    "build:server": "APP=main vite build --ssr entry-server.tsx --outDir ../../../dist/server --emptyOutDir",
    "devinstall": "zx ../../devinstall.mjs -- tsx src/server/index.ts --dev",
    "export:dataset": "tsx src/database/scripts/exportDataset.ts",
    "retention:run": "tsx src/database/scripts/runRetention.ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint -c .eslintrc.json --rulesdir .eslint-rules . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint -c .eslintrc.json --rulesdir .eslint-rules . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:emoji": "node scripts/lint-emoji.mjs",
    "page:test": "tsx src/server/scripts/sendTestPage.ts",
    "redteam": "tsx src/redteam/cli.ts",
    "redteam:smoke": "tsx src/redteam/cli.ts --suite smoke",
    "redteam:full": "tsx src/redteam/cli.ts --suite full",
    "redteam:quality": "tsx src/redteam/cli.ts --suite quality",
    "redteam:voice": "tsx src/redteam/cli.ts --suite voice",
    "redteam:voice-safety": "tsx src/redteam/cli.ts --suite voice-safety",
    "redteam:extended": "tsx src/redteam/cli.ts --suite extended",
    "redteam:voice-crawl": "tsx src/redteam/cli.ts --suite voice-crawl",
    "redteam:voice-walk": "tsx src/redteam/cli.ts --suite voice-walk",
    "redteam:voice-run": "tsx src/redteam/cli.ts --suite voice-run",
    "redteam:replay": "tsx src/redteam/replay.ts",
    "redteam:goldens": "tsx src/redteam/goldens/cli.ts",
    "redteam:ci-summary": "tsx src/redteam/ciSummary.ts",
    "redteam:flightdeck": "node src/redteam/flightdeckReport.ts",
    "counterfactual": "tsx src/database/scripts/runCounterfactual.ts",
    "irb:prompts": "tsx src/server/irb/buildPromptsAttachment.ts",
    "config:snapshot": "tsx src/database/scripts/exportConfigSnapshot.ts",
    "irb:redteam": "tsx src/server/irb/buildRedteamAttachment.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@aws-sdk/client-cognito-identity-provider": "^3.1075.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@socket.io/postgres-adapter": "^0.5.0",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "busboy": "^1.6.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.2",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.2.0",
    "history": "^5.3.0",
    "minipass": "^7.0.4",
    "nodemailer": "^10.6.0",
    "openai": "^7.57.0",
    "openai-realtime-api": "^1.0.8",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-feather": "^2.0.10",
    "react-router": "^7.18.5",
    "recharts": "^3.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "speakeasy": "^2.0.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/busboy": "^1.5.4",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "opusscript": "^0.1.1",
    "playwright": "^1.65.1",
    "postcss": "^8.5.6",
    "postcss-nesting": "^12.0.2",
    "postcss-preset-env": "^7.7.1",
    "prettier": "3.6.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.4.0",
    "vitest": "^5.1.0",
    "werift": "^0.25.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "archiver": {
      "readdir-glob": "^4.0.0"
    }
  }
}
