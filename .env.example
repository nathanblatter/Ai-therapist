# Environment configuration for AI Therapist
#
# Copy this file to .env and fill in real values. .env is gitignored.
#
# This file is the authoritative list of every environment variable the code
# reads (src/, scripts/, .github/workflows/, docker-compose*.yml). Each entry
# says what the variable does, what happens when it is unset, and which
# environment sets it:
#
#   dev    `npm run dev` on a laptop, reading this .env directly
#   stage  the home box (docker-compose.yml). The stage container only sees
#          variables that docker-compose.yml passes through explicitly, so a
#          key added here must ALSO be added to the compose `environment:`
#          block before it reaches the app. Deploy checkout: ~/deploy/Ai-therapist/.env
#   prod   AWS EC2 (docker-compose.prod.yml, `env_file: .env`): every key in
#          /opt/ai-therapist/.env reaches the container with no compose edit.
#   CI     GitHub Actions (deploy.yml / deploy-prod.yml / redteam-nightly.yml);
#          values come from workflow `env:` blocks and repo secrets, never from
#          a .env file.
#
# Secrets are shown as placeholders only. Never commit a filled-in copy.

# ======================
# Server
# ======================
# Runtime mode. production: secure cookies, CORS locked to CORS_ORIGIN, CSP,
# SESSION_SECRET required. test: silent logger. Default: unset (dev).
# dev: unset | stage/prod: production (compose) | CI: test
NODE_ENV=production
# HTTP port the app listens on. Default 3067. All environments.
PORT=3067
# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Required when NODE_ENV=production (boot refuses otherwise); dev falls back
# to an insecure placeholder. dev/stage/prod: set | CI: ci-redteam-secret
SESSION_SECRET=your_very_long_random_session_secret_at_least_64_characters_long
# Allowed browser origin for CORS when NODE_ENV=production (also the APP_URL
# fallback). Default: CORS disabled in production. stage: hardcoded in compose.
CORS_ORIGIN=https://ai-therapist.nathanblatter.com
# Public origin of this deployment, used to build Squawk redirect URIs.
# Defaults to CORS_ORIGIN. dev/stage/prod.
APP_URL=https://ai-therapist.nathanblatter.com
# Base URL embedded in caseworker alert emails (login link) and crisis
# notifications. Default: '' for emails, the stage URL for crisis alerts.
# stage/prod when email is on; not passed through by docker-compose.yml yet.
# APP_BASE_URL=https://ai-therapist.nathanblatter.com
# Enforce the Content-Security-Policy instead of report-only. Only 'true'
# enforces. Default: report-only. prod once the inline-script audit is done.
# CSP_ENFORCE=false
# pino log level (debug|info|warn|error|silent). Default: info, or silent
# under vitest / NODE_ENV=test. Any environment.
# LOG_LEVEL=info
# Socket.io Postgres adapter + background schedulers (retention, work-queue,
# Qualtrics sync, harness). Set to 'off' to run a second in-process copy of
# the server (red-team harness, participant-sim) without fanning emissions to
# live admin dashboards. Default: on. Set to 'off' by src/redteam and
# scripts/participant-sim themselves; never in a .env.
# SOCKET_PG_ADAPTER=off

# ======================
# Database (shared Postgres in ~/docker-services on stage; RDS on prod)
# ======================
# From inside the stage container the host is reached via host.docker.internal.
# Required everywhere (boot fails without it). CI: ephemeral service container.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/ai_therapist
# 'true' enables TLS (rejectUnauthorized=false) for managed Postgres such as
# RDS. Default: no TLS. prod: true | dev/stage/CI: false
DATABASE_SSL=false

# ======================
# Sign-in through Squawk (auth-service-33, https://squawk.nathanblatter.com)
# ======================
# Leave all of these unset for the legacy username/password login (dev, CI).
# When set, the login page runs Squawk's flow (password, passkey, owner passkey)
# and new accounts are mirrored into Squawk. Values come from the Squawk console:
# the service id + a service credential, and the OAuth client registered with
# redirect_uri {APP_URL}/api/auth/squawk/callback. See docs/squawk-auth.md.
# stage/prod: all set | dev/CI: unset
SQUAWK_ISSUER=https://squawk.nathanblatter.com
SQUAWK_SERVICE_ID=svc_...
SQUAWK_CREDENTIAL=nbc_...
SQUAWK_CLIENT_ID=nbc_...
SQUAWK_RESOURCE=https://ai-therapist.nathanblatter.com/api
# The local researcher account Nathan's owner passkey signs in as.
SQUAWK_OWNER_USERNAME=
# Squawk ADMIN token, read only by the one-time import script
# src/database/scripts/importToSquawk.ts. Never set in a deployed .env; pass
# it on the command line for that run (see the script header).
# SQUAWK_ADMIN_TOKEN=

# ======================
# OpenAI
# ======================
# Project key for GPT-Live / Realtime, chat, redaction, embeddings, evals.
# Required (boot fails without it). All environments; CI: repo secret.
OPENAI_API_KEY=sk-...
# OpenAI ADMIN key, server-side only, never shipped to a client. Create at
# platform.openai.com/settings/organization/admin-keys with "Read only"
# permissions: the app only reads GET /v1/organization/costs to render real
# spend in the admin Ops panel. Admin keys are a SEPARATE credential class
# that cannot make model calls, so this does not replace OPENAI_API_KEY.
# Default: unset, the spend card shows a setup hint. stage/prod (rotate with
# scripts/set-openai-admin-key.sh).
OPENAI_ADMIN_KEY=sk-admin-...
# Org monthly hard cap in USD, surfaced on the cost dashboard as a safety
# signal (a tripped cap 429s crisis detection too). Default 120. stage/prod.
# OPENAI_MONTHLY_CAP_USD=120

# ======================
# xAI (Grok Voice) -- optional
# ======================
# Only needed once system_config.ai_model is set to a grok-voice-* model
# (docs/grok-voice.md). The server proxies every voice session to
# wss://api.x.ai/v1/realtime with this key; it never reaches a browser. With
# the model switched and no key, session starts fail loudly (409).
# Default: unset. stage/prod when Grok is in use; never in CI.
XAI_API_KEY=xai-...
# Set to '1' to run the live Grok socket test (grokVoiceManager.live.test.ts)
# against the real API. Default: skipped. dev only, by hand.
# XAI_LIVE_TEST=1

# ======================
# Object storage (MinIO) for session audio recordings -- ai-therapist-17
# ======================
# MINIO_ENDPOINT is where the APP PROCESS reaches MinIO from, which differs by
# how you're running it:
#   - `npm run dev` / `npm start` directly on the host: http://127.0.0.1:9000
#   - App in Docker, MinIO in a container on the same network (the deployed
#     stage docker-compose.yml): http://minio:9000. The compose file hardcodes
#     this rather than reading it from .env so a host-local dev value here can
#     never leak into the container.
#   - App in Docker, MinIO on the HOST: http://host.docker.internal:9000.
# Default: http://127.0.0.1:9000 (src/server/config/objectStorage.ts).
MINIO_ENDPOINT=http://127.0.0.1:9000
# Bucket name. Default ai-therapist-recordings. stage: hardcoded in compose.
MINIO_BUCKET=ai-therapist-recordings
# Access key / secret. Default ''. dev/stage/prod. The nightly backup script
# reads the same two names from ~/docker-services/ai-therapist-backup.env.
MINIO_ROOT_USER=your_minio_access_key
MINIO_ROOT_PASSWORD=your_minio_secret_key
# S3 fallbacks: used only when the MINIO_* credentials above are unset, for a
# real AWS S3 bucket instead of MinIO. AWS_REGION defaults to us-east-1.
# Not set in any current environment.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ======================
# Cloudflare Tunnel (stage only, compose-only)
# ======================
# Read by the `tunnel` service in docker-compose.yml (as TUNNEL_TOKEN), not by
# the app. Prod terminates TLS with Caddy and does not use it.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ======================
# Crisis paging via the local iMessage bridge -- NEVER SET IN DEV OR CI
# ======================
# High-severity crisis events page the on-call phone through the iMessage HTTP
# API on the home box (reachable at the host's Tailscale IP). These three are
# documented here but intentionally left unset in dev; src/redteam/cli.ts,
# src/redteam/replay.ts and scripts/participant-sim force them to '' at boot.
# CI MUST NEVER CARRY THEM: the red-team suites drive real crisis ladders and
# would page a human. Runtime kill switch: system_config key 'crisis_alert'
# (docs/system-config-keys.md). stage/prod only.
# Bridge base URL. Default http://100.79.61.79:8899.
# IMESSAGE_API_URL=http://100.79.61.79:8899
# Bridge API key. Default '' (paging disabled, logged).
# IMESSAGE_API_KEY=
# On-call phone in E.164. Default '' (paging disabled). system_config
# crisis_alert.phone overrides it when non-null. scripts/prod-uptime-check.sh
# reads this and IMESSAGE_API_KEY from the stage .env.
# CRISIS_ALERT_PHONE=

# ======================
# Flightdeck tracker integration -- optional
# ======================
# In-app bug/feedback reports POST to Flightdeck. Default URL
# http://flightdeck:8080 (stage shares the docker-services network). Key has
# ingest scope only; unset => the report routes return 503. stage/prod.
# FLIGHTDECK_URL=http://flightdeck:8080
# FLIGHTDECK_INGEST_KEY=

# ======================
# Demo site / magic link (stage)
# ======================
# Secret embedded in the shareable magic link. Visiting /demo/<token>
# auto-provisions a capped "demo" account (5 sessions/day, 5 min each) and drops
# the visitor into a synthetic-data admin dashboard. Unset => /demo/:token 404s.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# stage only.
DEMO_MAGIC_TOKEN=
# 'true' keeps the demo pill/overlay and "[DEMO]" titles and allows the magic
# link under NODE_ENV=production. Only the stage box sets it (compose); prod
# serves clean HTML. Default: off.
# DEMO_SITE=true
# Allow the magic link in production WITHOUT demo branding. Default: off.
# Escape hatch only; not set anywhere today.
# ALLOW_DEMO=true
# Demo accounts older than this many days are swept daily. Default 7. stage.
# DEMO_MAX_AGE_DAYS=7

# ======================
# Evals, assistant, voice sideband
# ======================
# 'true' turns on the nightly harness scheduler and session-end auto-eval.
# Only stage sets it (compose); prod leaves it unset so no judge spend competes
# with live sessions (manual evals still work). Default: off.
# EVALS_ENABLED=true
# Admin assistant (docs/admin-assistant-spec.md); on only when exactly 'true'.
# Default: off (the chat route answers 503). stage/prod opt-in.
# ASSISTANT_ENABLED=true
# Kill switch for the GPT-Live server sideband. Set to 'false' to disable; this
# also disables crisis detection on the voice path, so it is loud. Default: on.
# Never set in a deployed .env except during an incident.
# SIDEBAND_ENABLED=true

# ======================
# Qualtrics survey-driven enrollment, sync, reminders (Phase 2) -- all optional
# ======================
# When the API token AND baseline survey id are set, /join-study?qid=<ResponseID>
# verifies a finished baseline response with the Qualtrics API and lets the
# participant create their study account in one step. Unset => the route
# behaves like an unknown path. Token: Qualtrics Account Settings -> API.
# stage/prod; never CI.
QUALTRICS_API_TOKEN=
QUALTRICS_BASELINE_SURVEY_ID=
# Datacenter host prefix. Default byu.pdx1.
QUALTRICS_DATACENTER=
# Numeric organization id stamped onto accounts created via /join-study.
# Default: the default org.
QUALTRICS_STUDY_ORG_ID=
# Response sync (POST /admin/api/qualtrics/sync + surveys.csv in dataset
# exports): any subset works; a survey with no id is simply not synced.
# Withdrawal responses additionally open a protocol work item.
QUALTRICS_WEEKLY_SURVEY_ID=
QUALTRICS_EXIT_SURVEY_ID=
QUALTRICS_WEEK12_SURVEY_ID=
QUALTRICS_WITHDRAWAL_SURVEY_ID=
# Background sync interval in minutes (min 5). Default 0 = manual sync only.
# Scheduler + linkage health: GET /admin/api/qualtrics/status. stage/prod.
# QUALTRICS_SYNC_INTERVAL_MINUTES=60
# Real-time completion webhook (POST /api/qualtrics/webhook): bcrypt HASH of
# the API key the surveys' Qualtrics Workflows send (X-API-TOKEN). The usable
# key lives only in the Qualtrics extension credential. Unset = route off
# (the scheduled sync still catches everything, just slower). Generate:
#   node -e "require('bcrypt').hash(process.argv[1],10).then(console.log)" <key>
QUALTRICS_WEBHOOK_SECRET_HASH=
# App-driven survey reminder emails sent through Qualtrics as the mailer
# (qualtricsReminders.service). Ships dark until ALL four are set, on top of
# the token + survey ids above. prod when reminders go live; not passed
# through by docker-compose.yml yet.
# QUALTRICS_DIRECTORY_ID=POOL_...
# QUALTRICS_MAILING_LIST_ID=CG_...
# QUALTRICS_LIBRARY_ID=UR_...
# QUALTRICS_REMINDER_MESSAGE_ID=MS_...

# ======================
# Quiet hours (Phase 2, ai-therapist-152) -- optional, OFF by default
# ======================
# When enabled, NEW participant sessions are blocked overnight (Denver
# wall-clock) and the app shows crisis resources instead, per the Phase 2 IRB
# application and consent form. Staff/demo/sandbox users are never blocked;
# in-progress sessions are never cut off. Defaults: 22 (10 PM) to 6 (6 AM).
# prod (Phase 2); not passed through by docker-compose.yml yet.
# QUIET_HOURS_ENABLED=true
# QUIET_HOURS_START_HOUR=22
# QUIET_HOURS_END_HOUR=6

# ======================
# Email notifications (caseworker portal) -- all optional
# ======================
# Absent SMTP_HOST/EMAIL_FROM = emailer is a logged no-op; in-app
# notifications and digests keep working. Port 465 switches to implicit TLS.
# Defaults: SMTP_PORT 587, everything else ''. Runtime kill switch:
# system_config key 'email_notifications'. prod when configured; not passed
# through by docker-compose.yml yet.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# ======================
# Red-team harness (src/redteam, docs/redteam.md) -- CI and local runs only
# ======================
# Credentials of the dedicated harness participant seeded by
# scripts/redteam-seed-user.mjs. Defaults: redteam_participant /
# redteam-Passw0rd!. Only matter against the ephemeral red-team DB.
# REDTEAM_PARTICIPANT_USER=redteam_participant
# REDTEAM_PARTICIPANT_PASS=
# Set (any value) to log every voice-socket event in the voice suite. dev.
# REDTEAM_VOICE_DEBUG=1
# Internal: set by harnessRunner.service on the child process to record what
# triggered a run (scheduled vs manual). Never set by hand.
# REDTEAM_TRIGGER=

# ======================
# One-off script knobs (scripts/, see scripts/README.md)
# ======================
# scripts/redaction-signal-check.mjs: sample size (default 200) and whether to
# include demo sessions ('1'). dev/stage by hand.
# SIGNAL_CHECK_LIMIT=200
# SIGNAL_CHECK_INCLUDE_DEMO=1
# Dataset export codebook provenance. Default: `git rev-parse --short HEAD`
# of the checkout; set it when exporting from an image with no .git.
# GIT_SHA=

# ======================
# Set by the tooling, never by hand (listed for completeness)
# ======================
# APP=main|admin         vite.config selects the client bundle (package.json build scripts)
# VITEST                 set by vitest; silences the logger
# TZ                     set by timezoneHelpers.tz.test.ts only
# GITHUB_ACTIONS, GITHUB_SHA, GITHUB_STEP_SUMMARY
#                        provided by GitHub Actions; the red-team CLI uses them
#                        to label runs (ci-smoke / ci-nightly) and write the
#                        job summary
# IMAGE_TAG              deploy-prod.yml -> docker-compose.prod.yml image tag

# Retired keys no longer read anywhere (remove from old .env files):
#   COOKIE_SECURE (cookies follow NODE_ENV), CRISIS_API_KEY (replaced by the
#   IMESSAGE_* pair above).
