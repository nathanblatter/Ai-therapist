# Environment Configuration for AI Therapist (self-hosted Docker)
# Copy this file to .env and fill in your actual values.
# .env is gitignored and is read by docker-compose.

# ======================
# Server Configuration
# ======================
NODE_ENV=production
PORT=3067

# ======================
# Database (shared Postgres in ~/docker-services)
# ======================
# From inside the container the host is reached via host.docker.internal.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/ai_therapist
# Set to "true" only for managed Postgres that requires TLS (e.g. RDS).
DATABASE_SSL=false

# ======================
# Session Configuration
# ======================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_very_long_random_session_secret_at_least_64_characters_long

# ======================
# OpenAI API (Realtime)
# ======================
# The OpenAI key for the Realtime API (gpt-realtime-2.1 or gpt-realtime-2.1-mini).
OPENAI_API_KEY=sk-...

# ======================
# Object storage (MinIO) for session audio recordings — ai-therapist-17
# ======================
# MINIO_ENDPOINT is where the APP PROCESS reaches MinIO from, which differs by
# how you're running it:
#   - `npm run dev` / `npm start` directly on the host: http://127.0.0.1:9000
#     (or wherever MinIO is bound on the host)
#   - App running in Docker, MinIO also in a container on the same Docker
#     network (this is how the deployed docker-compose.yml runs it): use the
#     MinIO container's service name, e.g. http://minio:9000 — see
#     docker-compose.yml, which hardcodes this rather than reading it from
#     .env so a host-local dev value here can never leak into the container.
#   - App running in Docker, MinIO running on the HOST (not containerized):
#     use http://host.docker.internal:9000 — the same host-gateway alias
#     already used for DATABASE_URL above (works because docker-compose.yml
#     sets `extra_hosts: host.docker.internal:host-gateway`).
# Defaults to http://127.0.0.1:9000 (config/objectStorage.ts) if unset, which
# only works for the "running directly on the host" case above.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=ai-therapist-recordings
MINIO_ROOT_USER=your_minio_access_key
MINIO_ROOT_PASSWORD=your_minio_secret_key

# ======================
# CORS / public origin
# ======================
CORS_ORIGIN=https://ai-therapist.nathanblatter.com

# ======================
# Cloudflare Tunnel
# ======================
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ======================
# Demo magic link (resume / portfolio access)
# ======================
# Secret embedded in the shareable magic link. Visiting /demo/<token>
# auto-provisions a capped "demo" account (5 sessions/day, 5 min each) and drops
# the visitor into a synthetic-data admin dashboard. Leave unset to DISABLE the
# feature entirely (the /demo route then 404s).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEMO_MAGIC_TOKEN=

# ======================
# Qualtrics survey-driven enrollment (Phase 2) — ALL optional
# ======================
# When the API token AND baseline survey id are set, /join-study?qid=<ResponseID>
# verifies a finished baseline response with the Qualtrics API and lets the
# participant create their study account in one step (the survey's completer
# branch redirects there at end-of-survey). Leave unset to DISABLE — the route
# then behaves like an unknown path. Token: Qualtrics Account Settings -> API.
QUALTRICS_API_TOKEN=
QUALTRICS_BASELINE_SURVEY_ID=
# Datacenter host prefix; defaults to byu.pdx1
QUALTRICS_DATACENTER=
# Optional organization id stamped onto accounts created via /join-study
QUALTRICS_STUDY_ORG_ID=
# Response sync (POST /admin/api/qualtrics/sync + surveys.csv in dataset
# exports): set the survey ids to sync. Any subset works; all-unset disables.
QUALTRICS_WEEKLY_SURVEY_ID=
QUALTRICS_EXIT_SURVEY_ID=
QUALTRICS_WEEK12_SURVEY_ID=
# Background sync interval in minutes (min 5). Unset/0 = manual sync only.
# Scheduler + linkage health: GET /admin/api/qualtrics/status
# QUALTRICS_SYNC_INTERVAL_MINUTES=60
# Real-time completion webhook: shared secret each survey's Qualtrics Workflow
# sends in X-Webhook-Token to POST /api/qualtrics/webhook. Unset = route off
# (the scheduled sync still catches everything, just slower).
QUALTRICS_WEBHOOK_SECRET=

# ======================
# Quiet hours (Phase 2, ai-therapist-152) — optional, OFF by default
# ======================
# When enabled, NEW participant sessions are blocked overnight (Denver
# wall-clock) and the app shows crisis resources instead, per the Phase 2 IRB
# application and consent form. Staff/demo/sandbox users are never blocked;
# in-progress sessions are never cut off. Defaults: 22 (10 PM) to 6 (6 AM).
# QUIET_HOURS_ENABLED=true
# QUIET_HOURS_START_HOUR=22
# QUIET_HOURS_END_HOUR=6

# ======================
# Email notifications (caseworker portal) — ALL optional
# ======================
# Absent SMTP_HOST/EMAIL_FROM = emailer is a logged no-op; in-app
# notifications and digests keep working. Port 465 switches to implicit TLS.
# APP_BASE_URL adds a login link (${APP_BASE_URL}/admin) to alert emails.
# Runtime kill switch: system_config key 'email_notifications'.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# APP_BASE_URL=https://ai-therapist.nathanblatter.com

# ======================
# Optional
# ======================
# COOKIE_SECURE=true
# CRISIS_API_KEY=
# LOG_LEVEL=info
