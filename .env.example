# Environment Configuration for AI Therapist (self-hosted Docker)
# Copy this file to .env and fill in your actual values.
# .env is gitignored and is read by docker-compose.

# ======================
# Server Configuration
# ======================
NODE_ENV=production
PORT=3067

# ======================
# Database (shared Postgres in ~/docker-services)
# ======================
# From inside the container the host is reached via host.docker.internal.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/ai_therapist
# Set to "true" only for managed Postgres that requires TLS (e.g. RDS).
DATABASE_SSL=false

# ======================
# Session Configuration
# ======================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_very_long_random_session_secret_at_least_64_characters_long

# ======================
# OpenAI API (Realtime) — via AWS Secrets Manager
# ======================
# The OpenAI key is read from Secrets Manager (secret: OpenAI-APIKEY).
# Provide AWS credentials so the container can fetch it.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-west-1

# ======================
# CORS / public origin
# ======================
CORS_ORIGIN=https://ai-therapist.nathanblatter.com

# ======================
# Cloudflare Tunnel
# ======================
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ======================
# Optional
# ======================
# COOKIE_SECURE=true
# CRISIS_API_KEY=
# LOG_LEVEL=info
